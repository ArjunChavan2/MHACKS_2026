    "fixtures": "tsx scripts/make-fixtures.ts",
    "test": "vitest run",
    "eval:extraction": "tsx --env-file-if-exists=.env.local scripts/eval-extraction.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:studio": "drizzle-kit studio",
    "finchnode:check": "tsx --env-file-if-exists=.env.local scripts/finchnode-check.ts",
    "worker:photon": "tsx --env-file-if-exists=.env.local workers/photon/index.ts",
    "call:test": "tsx --env-file-if-exists=.env.local scripts/call-test.ts",
    "agent:test": "tsx --env-file-if-exists=.env.local scripts/agent-test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@napi-rs/canvas": "^1.0.10",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@spectrum-ts/core": "^12.10.1",
    "@spectrum-ts/imessage": "^12.10.1",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
