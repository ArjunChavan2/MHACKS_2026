# Copy to .env.local and fill in. Never commit real keys (SPEC.md §2 rule 13).

# AI provider: "grok" or "gemini". Default: grok when XAI_API_KEY is set, otherwise gemini (SPEC.md §5.1).
# Use LLM_PROVIDER=gemini for the judged demo (MLH Gemini prize).
LLM_PROVIDER=
# xAI key for Grok (console.x.ai). Optional model override; default grok-4.20-0309-non-reasoning.
XAI_API_KEY=
XAI_MODEL=

# Google AI Studio key for Gemini (free tier: 20 requests/day per project). Without any AI key, use the sample documents.
GEMINI_API_KEY=
# Optional: override the pinned Gemini model (SPEC.md §12, open decision 15).
GEMINI_MODEL=   # default: gemini-3.5-flash

# Neon Postgres connection string (Neon console > Connect, "Pooled connection", Node.js).
# Without it, the app uses an in-memory store (lost on restart).
# Then run: npm run db:migrate && npm run db:check
DATABASE_URL=
# Optional: Neon's direct (non-pooled) string, used for migrations. The Vercel-Neon integration sets it.
DATABASE_URL_UNPOOLED=

# true (default) serves the saved sample records that match the sample bill; false loads real FinchNode synthetic records.
USE_MOCK=true
# FinchNode sandbox key (ck_test_…). With USE_MOCK=false: sandbox Connect, then the demo API, then the saved snapshot.
FINCHNODE_API_KEY=
# Optional: reuse a connected sandbox subject (skips Connect), or pick another synthetic scenario.
FINCHNODE_SUBJECT=
FINCHNODE_SCENARIO=   # default: multi-source-overlap
# Set to off to skip sandbox Connect (no 45 s wait while FinchNode's sandbox is stuck); uses the demo API.
FINCHNODE_CONNECT=

# --- Calls (MVP 4): Twilio Programmable Voice + ElevenLabs (SPEC.md §4.9, §7.1) ---
# Twilio console home: Account SID. API key: Account > API keys (type Standard); the secret is shown once.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Optional: only if code needs it; ElevenLabs' Twilio import asks for it in their dashboard instead.
TWILIO_AUTH_TOKEN=
# Trial number with Voice capability, E.164 format (+1...). Trials can only call Verified Caller IDs.
TWILIO_PHONE_NUMBER=
# Verified phone of the teammate playing the billing office (E.164).
DEMO_BILLING_PHONE=
# ElevenLabs: API key (Profile > API keys) and the Conversational AI agent ID.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- iMessage (MVP 3): Photon Spectrum worker (agent-notes/mvp3-imessage/PLAN.md) ---
# Worker only (never on Vercel): Photon project credentials.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Shown on the case screen ("text LINK <code> to ...").
PHOTON_NUMBER=
# Shared secret between the worker and /api/messaging/* (set the same value in Vercel). Any long random string.
MESSAGING_SECRET=
# Which deployment the worker calls, e.g. https://mhacks-2026.vercel.app or http://localhost:3000
APP_URL=
