# Copy to .env.local and fill in. Never commit real keys (SPEC.md §2 rule 13).

# Google AI Studio key for Gemini (document reading and drafting). Without it, use the sample documents.
GEMINI_API_KEY=
# Optional: override the pinned Gemini model (SPEC.md §12, open decision 15).
GEMINI_MODEL=   # default: gemini-flash-latest

# Neon Postgres connection string. Without it, the app uses an in-memory store (lost on restart).
DATABASE_URL=

# true (default) serves saved synthetic FinchNode records; live FinchNode arrives in MVP 2.
USE_MOCK=true
FINCHNODE_API_KEY=
